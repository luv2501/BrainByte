{
  "name": "brainbyte-server",
  "version": "1.0.0",
  "description": "BrainByte backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seedProblems.js",
    "seed:clean": "node src/scripts/seedProblems.js --clear",
    "test": "node src/tests/authTest.js && node src/tests/problemTest.js && node src/tests/seedTest.js && node src/tests/executionTest.js && node src/tests/submissionTest.js && node src/tests/aiTest.js",
    "test:auth": "node src/tests/authTest.js",
    "test:problems": "node src/tests/problemTest.js",
    "test:seed": "node src/tests/seedTest.js",
    "test:execution": "node src/tests/executionTest.js",
    "test:submissions": "node src/tests/submissionTest.js",
    "test:ai": "node src/tests/aiTest.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^11.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
