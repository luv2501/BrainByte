# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Local MongoDB: mongodb://127.0.0.1:27017/brainbyte
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/brainbyte
MONGO_URI=mongodb://127.0.0.1:27017/brainbyte

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# Code Execution (Piston)
PISTON_API_URL=https://emkc.org/api/v2/piston
# PISTON_API_KEY=your_piston_api_key_if_required

# AI Coding Assistant (Google Gemini / OpenAI compatible)
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
# Optional OpenAI compatible fallback
# AI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_openai_key

